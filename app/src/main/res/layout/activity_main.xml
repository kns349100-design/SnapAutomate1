<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SnapAutomate • OFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="20dp" />

        <Switch
            android:id="@+id/autoAcceptSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto Accept"
            android:textSize="17sp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Save &amp; Apply" />

        <Button
            android:id="@+id/openAccessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Open Accessibility Settings" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Test Visible Accept Button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="How to use:\n1. Turn on Accessibility for SnapAutomate.\n2. Turn Auto Accept ON and tap Save & Apply.\n3. Open Snapchat and go to your friend-request screen.\n4. Keep Snapchat in the foreground while requests are processed.\n\nThe app only targets visible, enabled controls labelled Accept/Accept Request in Snapchat."
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
